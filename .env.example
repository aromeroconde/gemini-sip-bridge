# Gemini API
SIP_PROXY_URL=https://api-proxy.smartnexo.com
SIP_PROXY_TOKEN=
GEMINI_MODEL=gemini-3.8-live

# Voice Configuration
VOICE_NAME=Zephyr
# El prompt del agente se carga desde prompts/voice_prompt.txt
# Puedes sobreescribirlo aquí si necesitas: VOICE_PROMPT="..."

# Analysis Model (REST API, used for post-call analysis)
ANALYSIS_MODEL=gemini-2.5-flash

# LiveKit Cloud
LIVEKIT_URL=wss://ahc-kz1pb8rv.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Tool Webhooks
DATOS_CLIENTE_WEBHOOK_URL=
PRECIO_WEBHOOK_URL=
REPORT_WEBHOOK_URL=

# Costo por minuto USD del modelo Gemini Live (para estimación por llamada)
# Ejemplo: 0.0035 — dejar en 0 si no se quiere calcular
GEMINI_LIVE_COST_PER_MINUTE=0

# Server
PORT=3001
